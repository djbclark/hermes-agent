    <array>
        <string>/Users/djbclark/.hermes/hermes-agent/.venv/bin/python</string>
        <string>/Users/djbclark/.hermes/hermes-agent-worktrees/memory-capacity-guard-v2/cron/scripts/memory_journal_consumer.py</string>
